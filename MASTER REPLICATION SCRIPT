  nfore = 10,
  connectedness = "Time"
)

DY_rolling <- ConnectednessApproach(
  volatility,
  model = "VAR",
  nlag = 1,
  nfore = 10,
  connectedness = "Time",
  window.size = 100
)

save(
  DY_static,
  DY_rolling,
  file = "objects/rdata/dy_time_domain.RData"
)



