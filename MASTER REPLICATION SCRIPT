############################
# 11. FREQUENCY CONNECTEDNESS
# Barunik & Krehlik (2018)
############################

Y <- na.omit(volatility)

p <- 2
H <- 500

fit <- vars::VAR(Y,p=p,type="const")

get_Phi <- function(fit,p){

  N <- length(fit$varresult)
  Phi <- array(0,dim=c(N,N,p))

  for(i in 1:N){

    coefs <- coef(fit$varresult[[i]])[-1]

    for(lag in 1:p){
      Phi[i,,lag] <- coefs[((lag-1)*N+1):(lag*N)]
    }
  }

  return(Phi)
}

Phi <- get_Phi(fit,p)

Sigma <- cov(residuals(fit))

ca_freq <- FrequencyConnectedness(
  Phi         = Phi,
  Sigma       = Sigma,
  nfore       = H,
  partition   = c(pi,pi/3,0),
  generalized = TRUE
)


TCI  <- ca_freq$TCI
NET  <- ca_freq$NET
TABLE <- ca_freq$TABLE


Freq_NET_Table <- NET[,,2:3]

Freq_TCI_Table <- data.frame(
  Band = c("Short-run","Long-run"),
  TCI  = TCI[1,2:3]
)



