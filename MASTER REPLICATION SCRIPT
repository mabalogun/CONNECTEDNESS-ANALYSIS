add_tbl <- function(doc,tbl,title){

  doc %>%
    body_add_par(title,style="heading 1") %>%
    body_add_flextable(
      autofit(flextable(tbl))
    ) %>%
    body_add_par("")
}

doc <- read_docx()

doc <- add_tbl(doc,Table_0,"Table 1: Descriptive Statistics")
doc <- add_tbl(doc,Table_A,"Table 2: Static Spillover Matrix")
doc <- add_tbl(doc,Table_B,"Table 3: Average Directional Spillovers")
doc <- add_tbl(doc,Table_C,"Table 4: TCI Summary")
doc <- add_tbl(doc,Table_D,"Table 5: Net Spillover Ranking")
doc <- add_tbl(doc,Freq_NET_Table,"Table 6: Frequency Spillovers")

print(
  doc,
  target="objects/doc/connectedness_tables.docx"
)



