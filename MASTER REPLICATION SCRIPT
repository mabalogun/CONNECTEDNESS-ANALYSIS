############################

Table_A <- DY_static$TABLE

Table_B <- data.frame(
  Asset = colnames(volatility),
  TO    = colMeans(DY_rolling$TO,   na.rm = TRUE),
  FROM  = colMeans(DY_rolling$FROM, na.rm = TRUE),
  NET   = colMeans(DY_rolling$NET,  na.rm = TRUE)
)

Table_C <- data.frame(
